# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection (read by module SDK)
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_MODULE_ID=your-module

# Core / compose only (this scaffold hardcodes Insecure: true in cmd/module)
# MUXCORE_INSECURE_DISABLE_TLS=true

# Add module-specific settings here as you implement them.
