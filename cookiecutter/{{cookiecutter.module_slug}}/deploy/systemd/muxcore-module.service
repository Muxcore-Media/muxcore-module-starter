[Unit]
Description=MuxCore Module - {{ cookiecutter.module_slug }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/{{ cookiecutter.module_slug }} \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id {{ cookiecutter.module_slug }}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/{{ cookiecutter.module_slug }}

[Install]
WantedBy=multi-user.target
